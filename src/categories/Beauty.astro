---
// Template per la categoria "Beauty & wellness": centri estetici, parrucchieri, saloni.
// Non contiene mai testo o dati specifici di un'azienda: tutto arriva da `lead`.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Gallery from '../components/Gallery.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ContactSection from '../components/ContactSection.astro';

interface Props {
  lead: CollectionEntry<'leads'>['data'];
}

const { lead } = Astro.props;

const FONTS_HREF = 'https://fonts.googleapis.com/css2?family=Marcellus&family=Poppins:wght@400;500;600&display=swap';

const days = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];
const slotsByDay = [
  ['09:30', '11:00', '15:00'],
  ['10:00', '14:30', '16:30'],
  ['09:30', '12:00', '15:30'],
  ['11:00', '14:00', '17:00'],
  ['09:30', '13:00', '16:00', '18:00'],
  ['09:00', '10:30', '12:00'],
];

const whatsappBase = `https://wa.me/${lead.contact.whatsapp.replace(/[^0-9]/g, '')}`;

const navLinks = [
  { label: 'Listino', href: '#servizi' },
  { label: 'Prenota', href: '#prenota' },
  { label: 'Recensioni', href: '#recensioni' },
  { label: 'Contatti', href: '#contatti' },
];
---

<BaseLayout
  title={lead.seo?.title ?? `${lead.businessName} — ${lead.tagline}`}
  description={lead.seo?.description ?? lead.description}
  businessName={lead.businessName}
  tagline={lead.tagline}
  colors={lead.colors}
  whatsapp={lead.contact.whatsapp}
  phone={lead.contact.phone}
  navLinks={navLinks}
  navCtaText="Prenota ora"
  navCtaHref="#prenota"
  fontsHref={FONTS_HREF}
  fontSerif="'Marcellus', ui-serif, Georgia, serif"
  fontSans="'Poppins', ui-sans-serif, system-ui, sans-serif"
>
  <Hero
    eyebrow="Beauty & wellness"
    badge={lead.badge}
    businessName={lead.businessName}
    tagline={lead.tagline}
    heroImage={lead.heroImage}
    ctaText={lead.ctaText}
    ctaHref="#prenota"
    stats={lead.stats}
  />

  <section class="mx-auto max-w-6xl px-6 py-20 sm:px-8 sm:py-28">
    <div class="grid items-stretch gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal class="overflow-hidden rounded-2xl">
        <img
          src={lead.aboutImage ?? lead.gallery[0] ?? lead.heroImage}
          alt={lead.businessName}
          class="aspect-[4/5] h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div data-reveal style="transition-delay: 120ms" class="flex flex-col justify-center">
        <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
          <span class="h-px w-8 bg-primary/50"></span>
          Chi siamo
        </p>
        <h2 class="font-serif text-3xl font-medium leading-tight text-stone-900 sm:text-4xl">Il nostro salone</h2>
        <p class="mt-6 text-lg leading-relaxed text-stone-600">{lead.description}</p>
        {
          lead.aboutQuote && (
            <blockquote class="mt-10 border-l-2 border-primary/40 pl-6">
              <p class="font-serif text-xl italic leading-snug text-stone-800">&ldquo;{lead.aboutQuote.text}&rdquo;</p>
              <cite class="mt-3 block text-sm not-italic font-medium text-stone-500">— {lead.aboutQuote.author}</cite>
            </blockquote>
          )
        }
      </div>
    </div>
  </section>

  <ServiceGrid
    id="servizi"
    eyebrow="Listino"
    title={lead.servicesTitle ?? 'I nostri servizi'}
    subtitle={lead.servicesSubtitle}
    services={lead.services}
  />

  <section id="prenota" class="bg-stone-100 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl px-6 sm:px-8">
      <div data-reveal class="mb-14 max-w-xl">
        <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
          <span class="h-px w-8 bg-primary/50" />
          Disponibilità
        </p>
        <h2 class="font-serif text-3xl font-medium text-stone-900 sm:text-4xl">Prenota il tuo appuntamento</h2>
        <p class="mt-3 text-stone-600">Scegli un giorno e un orario indicativo: confermiamo subito su WhatsApp.</p>
      </div>

      <div data-reveal class="grid grid-cols-3 gap-3 sm:grid-cols-6 sm:gap-4">
        {days.map((day, i) => (
          <div class="rounded-2xl bg-white p-4 text-center ring-1 ring-stone-200">
            <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">{day}</p>
            <div class="mt-3 flex flex-col gap-2">
              {slotsByDay[i].map((slot) => (
                <button
                  type="button"
                  data-slot-btn
                  data-day={day}
                  data-time={slot}
                  class="rounded-lg border border-stone-200 py-1.5 text-xs font-medium text-stone-700 transition-colors hover:border-primary hover:bg-primary hover:text-white"
                >
                  {slot}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 flex flex-col items-center gap-3 text-center">
        <p data-slot-summary class="text-sm text-stone-500">Seleziona un orario, oppure scrivici direttamente.</p>
        <a
          data-whatsapp-cta
          href={whatsappBase}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-sm font-semibold text-white shadow-lg shadow-primary/20 transition-transform hover:scale-[1.03] active:scale-95"
        >
          Prenota su WhatsApp
        </a>
      </div>
    </div>
  </section>

  <script define:vars={{ whatsappBase, businessName: lead.businessName }}>
    document.querySelectorAll('[data-slot-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-slot-btn]').forEach((b) => b.classList.remove('bg-primary', 'text-white', 'border-primary'));
        btn.classList.add('bg-primary', 'text-white', 'border-primary');

        const day = btn.getAttribute('data-day');
        const time = btn.getAttribute('data-time');
        const summary = document.querySelector('[data-slot-summary]');
        if (summary) summary.textContent = `Hai selezionato ${day} alle ${time} — confermalo su WhatsApp.`;

        const cta = document.querySelector('[data-whatsapp-cta]');
        if (cta) {
          const message = `Ciao! Vorrei prenotare per ${day} alle ${time} da ${businessName}.`;
          cta.setAttribute('href', `${whatsappBase}?text=${encodeURIComponent(message)}`);
        }
      });
    });
  </script>

  <Gallery eyebrow="Il salone" title={lead.galleryTitle ?? 'Ambienti e lavori'} images={lead.gallery} alt={lead.businessName} />

  {
    lead.reviews.length > 0 && (
      <section id="recensioni" class="bg-white py-20 sm:py-28">
        <div class="mx-auto max-w-6xl px-6 sm:px-8">
          <p data-reveal class="mb-14 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
            <span class="h-px w-8 bg-primary/50" />
            Recensioni
          </p>
          <div class="grid gap-6 sm:grid-cols-3">
            {lead.reviews.map((review) => (
              <ReviewCard text={review.text} author={review.author} rating={review.rating} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ContactSection eyebrow="Contatti" title="Vieni a trovarci" contact={lead.contact} />
</BaseLayout>
