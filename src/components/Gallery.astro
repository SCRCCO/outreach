---
interface Props {
  title?: string;
  subtitle?: string;
  eyebrow?: string;
  images: string[];
  alt?: string;
}

const { title, subtitle, eyebrow, images, alt = '' } = Astro.props;

// Ritmo masonry: alterna riquadri grandi e piccoli invece di una griglia uniforme.
const spanPattern = [
  'col-span-2 row-span-2',
  'col-span-2 row-span-1',
  'col-span-1 row-span-1',
  'col-span-1 row-span-1',
  'col-span-2 row-span-1',
  'col-span-1 row-span-1',
];
---

{
  images.length > 0 && (
    <section id="galleria" class="mx-auto max-w-6xl px-6 py-20 sm:px-8 sm:py-28">
      {(eyebrow || title) && (
        <div data-reveal class="mb-14 max-w-xl">
          {eyebrow && (
            <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
              <span class="h-px w-8 bg-primary/50" />
              {eyebrow}
            </p>
          )}
          {title && <h2 class="font-serif text-3xl font-medium text-stone-900 sm:text-4xl">{title}</h2>}
          {subtitle && <p class="mt-3 text-stone-600">{subtitle}</p>}
        </div>
      )}
      <div class="grid auto-rows-[130px] grid-cols-2 gap-3 sm:auto-rows-[160px] sm:grid-cols-4 sm:gap-4">
        {images.map((src, i) => (
          <div
            data-reveal
            style={`transition-delay:${(i % 4) * 70}ms`}
            class={`overflow-hidden rounded-xl bg-stone-100 ${spanPattern[i % spanPattern.length]}`}
          >
            <img
              src={src}
              alt={alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            />
          </div>
        ))}
      </div>
    </section>
  )
}
