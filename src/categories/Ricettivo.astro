---
// Template per la categoria "Ricettivo": agriturismi, B&B, cantine con ospitalità.
// Non contiene mai testo o dati specifici di un'azienda: tutto arriva da `lead`
// (un file in src/content/leads/, validato da src/content.config.ts).
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Gallery from '../components/Gallery.astro';
import BookingForm from '../components/BookingForm.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ContactSection from '../components/ContactSection.astro';

interface Props {
  lead: CollectionEntry<'leads'>['data'];
}

const { lead } = Astro.props;
const aboutImage = lead.aboutImage ?? lead.gallery[0] ?? lead.heroImage;
const [featuredReview, ...otherReviews] = lead.reviews;

const navLinks = [
  { label: 'Camere', href: '#servizi' },
  { label: 'Galleria', href: '#galleria' },
  { label: 'Recensioni', href: '#recensioni' },
  { label: 'Contatti', href: '#contatti' },
];
---

<BaseLayout
  title={lead.seo?.title ?? `${lead.businessName} — ${lead.tagline}`}
  description={lead.seo?.description ?? lead.description}
  businessName={lead.businessName}
  tagline={lead.tagline}
  colors={lead.colors}
  whatsapp={lead.contact.whatsapp}
  phone={lead.contact.phone}
  navLinks={navLinks}
  navCtaText="Richiedi disponibilità"
  navCtaHref="#richiesta"
>
  <Hero
    eyebrow="Ricettivo & ospitalità"
    businessName={lead.businessName}
    tagline={lead.tagline}
    heroImage={lead.heroImage}
    ctaText={lead.ctaText}
    ctaHref="#servizi"
    stats={lead.stats}
  />

  <section class="mx-auto max-w-6xl px-6 py-20 sm:px-8 sm:py-28">
    <div class="grid items-stretch gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal class="overflow-hidden rounded-2xl">
        <img src={aboutImage} alt={lead.businessName} class="aspect-[4/5] h-full w-full object-cover" loading="lazy" />
      </div>
      <div data-reveal style="transition-delay: 120ms" class="flex flex-col justify-center">
        <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
          <span class="h-px w-8 bg-primary/50"></span>
          Chi siamo
        </p>
        <h2 class="font-serif text-3xl font-medium leading-tight text-stone-900 sm:text-4xl">La nostra storia</h2>
        <p class="mt-6 text-lg leading-relaxed text-stone-600">{lead.description}</p>
        {
          lead.aboutQuote && (
            <blockquote class="mt-10 border-l-2 border-primary/40 pl-6">
              <p class="font-serif text-xl italic leading-snug text-stone-800">&ldquo;{lead.aboutQuote.text}&rdquo;</p>
              <cite class="mt-3 block text-sm not-italic font-medium text-stone-500">— {lead.aboutQuote.author}</cite>
            </blockquote>
          )
        }
      </div>
    </div>
  </section>

  <ServiceGrid
    id="servizi"
    eyebrow="Ospitalità"
    title={lead.servicesTitle ?? 'Camere & esperienze'}
    subtitle={lead.servicesSubtitle}
    services={lead.services}
  />

  <Gallery
    eyebrow="Il podere"
    title={lead.galleryTitle ?? 'Un assaggio del posto'}
    images={lead.gallery}
    alt={lead.businessName}
  />

  <BookingForm
    id="richiesta"
    eyebrow="Prenotazione"
    title={lead.formTitle ?? 'Richiedi disponibilità'}
    subtitle={lead.formSubtitle ?? 'Scrivici le date che hai in mente: ti rispondiamo con disponibilità e preventivo.'}
    note="Rispondiamo entro 24 ore, anche via WhatsApp."
    submitLabel="Richiedi disponibilità"
    fields={[
      { name: 'nome', label: 'Nome e cognome', type: 'text', required: true, placeholder: 'Mario Rossi' },
      { name: 'contatto', label: 'Email o telefono', type: 'text', required: true, placeholder: 'mario@email.it' },
      { name: 'checkin', label: 'Arrivo', type: 'date', required: true },
      { name: 'checkout', label: 'Partenza', type: 'date', required: true },
      { name: 'ospiti', label: 'Numero ospiti', type: 'number', required: true, placeholder: '2' },
      { name: 'messaggio', label: 'Note (opzionale)', type: 'textarea', placeholder: 'Richieste particolari, animali, allergie...' },
    ]}
  />

  {
    lead.reviews.length > 0 && (
      <section id="recensioni" class="bg-white py-20 sm:py-28">
        <div class="mx-auto max-w-6xl px-6 sm:px-8">
          <p data-reveal class="mb-4 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
            <span class="h-px w-8 bg-primary/50" />
            Recensioni
          </p>
          {featuredReview && <ReviewCard text={featuredReview.text} author={featuredReview.author} rating={featuredReview.rating} featured />}

          {otherReviews.length > 0 && (
            <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {otherReviews.map((review) => (
                <ReviewCard text={review.text} author={review.author} rating={review.rating} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <ContactSection eyebrow="Contatti" title="Vieni a trovarci" contact={lead.contact} />
</BaseLayout>
