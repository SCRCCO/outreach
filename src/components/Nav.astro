---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  businessName: string;
  links: NavLink[];
  ctaText?: string;
  ctaHref?: string;
}

const { businessName, links, ctaText, ctaHref = '#contatti' } = Astro.props;
---

<header data-nav class="fixed inset-x-0 top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 sm:px-8">
    <a href="#" data-nav-text class="font-serif text-lg font-medium tracking-wide">{businessName}</a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-text
            data-nav-link
            class="relative py-1 text-sm font-medium opacity-90 transition-opacity hover:opacity-100"
          >
            {link.label}
          </a>
        ))
      }
      {
        ctaText && (
          <a
            href={ctaHref}
            data-magnetic
            class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white transition-transform hover:scale-[1.03] active:scale-95"
          >
            {ctaText}
          </a>
        )
      }
    </nav>

    <button
      type="button"
      data-nav-toggle
      aria-label="Apri il menu"
      aria-expanded="false"
      class="flex h-10 w-10 items-center justify-center rounded-full md:hidden"
    >
      <svg data-nav-text data-icon-open viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg data-icon-close viewBox="0 0 24 24" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div data-mobile-menu class="fixed inset-0 z-30 hidden flex-col items-center justify-center gap-7 bg-stone-950 text-white">
    {
      links.map((link) => (
        <a href={link.href} data-mobile-link data-nav-link class="relative font-serif text-2xl">
          {link.label}
        </a>
      ))
    }
    {
      ctaText && (
        <a href={ctaHref} data-mobile-link class="mt-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold">
          {ctaText}
        </a>
      )
    }
  </div>
</header>

<style>
  header[data-nav] {
    background: transparent;
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  header[data-nav][data-scrolled='true'] {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(28, 25, 23, 0.06);
  }
  header[data-nav] [data-nav-text] {
    color: #fff;
    transition: color 0.3s ease;
  }
  header[data-nav][data-scrolled='true'] [data-nav-text] {
    color: #1c1917;
  }
  [data-mobile-menu].is-open {
    display: flex;
  }

  /* Indicatore di sezione attiva (scrollspy): una piccola linea sotto la voce corrente. */
  [data-nav-link]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  [data-nav-link].nav-active {
    opacity: 1;
  }
  [data-nav-link].nav-active::after {
    transform: scaleX(1);
  }
</style>

<script define:vars={{ sectionHrefs: links.map((l) => l.href) }}>
  const nav = document.querySelector('[data-nav]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const iconOpen = document.querySelector('[data-icon-open]');
  const iconClose = document.querySelector('[data-icon-close]');

  const setScrolled = () => {
    nav?.setAttribute('data-scrolled', window.scrollY > 40 ? 'true' : 'false');
  };
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  const closeMenu = () => {
    mobileMenu?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Scrollspy: evidenzia in nav la sezione attualmente a schermo.
  // Rimandato a DOMContentLoaded: questo script gira subito dopo </header>,
  // prima che il resto della pagina (le sezioni con id) sia stato parsato.
  document.addEventListener('DOMContentLoaded', () => {
    if (sectionHrefs.length === 0) return;
    const sections = sectionHrefs.map((href) => document.querySelector(href)).filter(Boolean);
    if (sections.length === 0) return;
    const navLinkEls = document.querySelectorAll('[data-nav-link]');

    const updateActive = () => {
      const scrollPos = window.scrollY + 140;
      let activeHref = null;
      for (const section of sections) {
        if (section.offsetTop <= scrollPos) activeHref = '#' + section.id;
      }
      navLinkEls.forEach((el) => {
        el.classList.toggle('nav-active', el.getAttribute('href') === activeHref);
      });
    };
    updateActive();
    window.addEventListener('scroll', updateActive, { passive: true });
  });
</script>
