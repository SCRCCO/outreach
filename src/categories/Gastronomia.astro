---
// Template per la categoria "Gastronomia": ristoranti, gastronomie.
// Non contiene mai testo o dati specifici di un'azienda: tutto arriva da `lead`.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import BookingForm from '../components/BookingForm.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ContactSection from '../components/ContactSection.astro';

interface Props {
  lead: CollectionEntry<'leads'>['data'];
}

const { lead } = Astro.props;

const FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Karla:wght@400;500;600&display=swap';

type MenuItem = (typeof lead.services)[number];
const menuGroups = lead.services.reduce<Record<string, MenuItem[]>>((acc, item) => {
  const group = item.group ?? 'Menu';
  (acc[group] ??= []).push(item);
  return acc;
}, {});

const navLinks = [
  { label: 'Menu', href: '#menu' },
  { label: 'Orari', href: '#orari' },
  { label: 'Prenota', href: '#prenota' },
  { label: 'Contatti', href: '#contatti' },
];
---

<BaseLayout
  title={lead.seo?.title ?? `${lead.businessName} — ${lead.tagline}`}
  description={lead.seo?.description ?? lead.description}
  businessName={lead.businessName}
  tagline={lead.tagline}
  colors={lead.colors}
  whatsapp={lead.contact.whatsapp}
  phone={lead.contact.phone}
  navLinks={navLinks}
  navCtaText="Prenota un tavolo"
  navCtaHref="#prenota"
  fontsHref={FONTS_HREF}
  fontSerif="'Playfair Display', ui-serif, Georgia, serif"
  fontSans="'Karla', ui-sans-serif, system-ui, sans-serif"
>
  <Hero
    eyebrow="Gastronomia"
    badge={lead.badge}
    businessName={lead.businessName}
    tagline={lead.tagline}
    heroImage={lead.heroImage}
    ctaText={lead.ctaText}
    ctaHref="#menu"
    stats={lead.stats}
  />

  <section class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-28">
    <p data-reveal class="mb-4 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
      <span class="h-px w-8 bg-primary/50" />
      Chi siamo
    </p>
    <h2 data-reveal class="font-serif text-3xl font-medium text-stone-900 sm:text-4xl">La nostra cucina</h2>
    <p data-reveal style="transition-delay: 100ms" class="mt-6 text-lg leading-relaxed text-stone-600">{lead.description}</p>
  </section>

  <section id="menu" class="bg-stone-950 py-20 text-white sm:py-28">
    <div class="mx-auto max-w-3xl px-6 sm:px-8">
      <div data-reveal class="mb-14 text-center">
        <p class="mb-4 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-accent">
          <span class="h-px w-8 bg-accent/60" />
          Il menu
        </p>
        <h2 class="font-serif text-3xl font-medium sm:text-4xl">{lead.servicesTitle ?? 'Cosa proponiamo'}</h2>
        {lead.servicesSubtitle && <p class="mt-3 text-white/60">{lead.servicesSubtitle}</p>}
      </div>

      {
        Object.entries(menuGroups).map(([group, items], gi) => (
          <div data-reveal style={`transition-delay:${gi * 80}ms`} class="mb-12 last:mb-0">
            <h3 class="mb-5 font-serif text-xl uppercase tracking-[0.15em] text-accent">{group}</h3>
            <ul class="space-y-5">
              {items.map((item) => (
                <li>
                  <div class="flex items-baseline gap-3">
                    <span class="font-serif text-lg text-white">{item.name}</span>
                    <span class="flex-1 border-b border-dotted border-white/25" />
                    {item.price && <span class="font-sans text-base font-medium text-accent">{item.price}</span>}
                  </div>
                  <p class="mt-1 text-sm leading-relaxed text-white/55">{item.description}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {
    lead.hours && lead.hours.length > 0 && (
      <section id="orari" class="mx-auto max-w-2xl px-6 py-20 sm:py-28">
        <div data-reveal class="text-center">
          <p class="mb-4 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">
            <span class="h-px w-8 bg-primary/50" />
            Orari
          </p>
          <h2 class="font-serif text-3xl font-medium text-stone-900 sm:text-4xl">Quando siamo aperti</h2>
        </div>
        <dl data-reveal class="mx-auto mt-10 max-w-md divide-y divide-stone-200 rounded-2xl bg-white ring-1 ring-stone-200">
          {lead.hours.map((h) => (
            <div class="flex items-center justify-between px-6 py-4">
              <dt class="font-medium text-stone-900">{h.day}</dt>
              <dd class="text-stone-600">{h.time}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <BookingForm
    id="prenota"
    eyebrow="Prenotazione"
    title={lead.formTitle ?? 'Prenota un tavolo'}
    subtitle={lead.formSubtitle ?? 'Scrivici data, ora e numero di persone: confermiamo la prenotazione a stretto giro.'}
    note="Rispondiamo entro poche ore, anche via WhatsApp."
    submitLabel="Prenota tavolo"
    fields={[
      { name: 'nome', label: 'Nome e cognome', type: 'text', required: true, placeholder: 'Mario Rossi' },
      { name: 'contatto', label: 'Email o telefono', type: 'text', required: true, placeholder: 'mario@email.it' },
      { name: 'data', label: 'Data', type: 'date', required: true },
      { name: 'ora', label: 'Ora', type: 'text', required: true, placeholder: '20:30' },
      { name: 'persone', label: 'Numero persone', type: 'number', required: true, placeholder: '2' },
      { name: 'note', label: 'Note (opzionale)', type: 'textarea', placeholder: 'Allergie, intolleranze, occasioni speciali...' },
    ]}
  />

  <Gallery eyebrow="In sala e in cucina" title={lead.galleryTitle ?? 'Un assaggio'} images={lead.gallery} alt={lead.businessName} />

  {
    lead.reviews.length > 0 && (
      <section class="bg-white py-20 sm:py-28">
        <div class="mx-auto max-w-6xl px-6 sm:px-8">
          <div class="grid gap-6 sm:grid-cols-3">
            {lead.reviews.map((review) => (
              <ReviewCard text={review.text} author={review.author} rating={review.rating} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ContactSection eyebrow="Contatti" title="Vieni a trovarci" contact={lead.contact} />
</BaseLayout>
