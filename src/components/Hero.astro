---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  badge?: string;
  businessName: string;
  tagline: string;
  heroImage: string;
  ctaText: string;
  ctaHref: string;
  stats?: Stat[];
}

const { eyebrow, badge, businessName, tagline, heroImage, ctaText, ctaHref, stats } = Astro.props;
---

<section class="relative flex min-h-[100svh] items-end overflow-hidden bg-stone-900">
  <img
    data-parallax-img
    src={heroImage}
    alt={businessName}
    class="absolute inset-0 h-full w-full scale-110 object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-primary/25 mix-blend-multiply"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/10 to-black/75"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>

  {
    badge && (
      <span class="absolute right-6 top-24 z-10 rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.15em] text-white backdrop-blur-sm sm:right-8">
        {badge}
      </span>
    )
  }

  <div class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-20 pt-32 sm:px-8 sm:pb-28">
    <div class="max-w-2xl">
      {
        eyebrow && (
          <p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-white/75">
            <span class="h-px w-8 bg-white/50" />
            {eyebrow}
          </p>
        )
      }
      <h1 class="font-serif text-[2.75rem] leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl">
        {businessName}
      </h1>
      <p class="mt-6 max-w-lg text-lg text-white/85 sm:text-xl">{tagline}</p>
      <a
        href={ctaHref}
        data-magnetic
        class="mt-9 inline-flex items-center justify-center gap-2 rounded-full bg-primary px-8 py-4 text-sm font-semibold text-white shadow-xl shadow-black/30 transition-transform hover:scale-[1.03] active:scale-95"
      >
        {ctaText}
        <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m0 0-5-5m5 5-5 5" />
        </svg>
      </a>
    </div>

    {
      stats && stats.length > 0 && (
        <div class="mt-14 grid max-w-2xl grid-cols-2 gap-x-8 gap-y-6 border-t border-white/20 pt-8 sm:grid-cols-4 sm:gap-x-10">
          {stats.map((stat) => (
            <div>
              <p data-counter data-value={stat.value} class="font-serif text-3xl text-white sm:text-4xl">
                {stat.value}
              </p>
              <p class="mt-1 text-xs uppercase tracking-[0.15em] text-white/70">{stat.label}</p>
            </div>
          ))}
        </div>
      )
    }
  </div>

  <div class="absolute bottom-6 right-6 z-10 hidden items-center gap-2 text-xs uppercase tracking-[0.2em] text-white/60 sm:flex">
    <span class="h-8 w-px animate-pulse bg-white/40"></span>
    Scorri
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Parallasse leggero: l'immagine dell'hero si muove più lentamente dello scroll.
  const parallaxImg = document.querySelector<HTMLElement>('[data-parallax-img]');
  const heroSection = parallaxImg?.closest('section');
  if (parallaxImg && heroSection && !reduceMotion) {
    let ticking = false;
    let inView = true;
    const update = () => {
      const offset = window.scrollY * 0.25;
      parallaxImg.style.transform = `translateY(${offset}px) scale(1.1)`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!inView || ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
    }).observe(heroSection);
  }

  // Contatori animati per le statistiche in hero.
  function animateCounter(el: HTMLElement) {
    const raw = el.dataset.value ?? el.textContent ?? '';
    const match = raw.match(/^(\D*)([\d.,]+)(.*)$/);
    if (!match) return;
    const [, prefix, numRaw, suffix] = match;
    const normalized = numRaw.replace(',', '.');
    const target = parseFloat(normalized);
    if (Number.isNaN(target)) return;
    const decimals = (normalized.split('.')[1] ?? '').length;

    if (reduceMotion) {
      el.textContent = raw;
      return;
    }

    const duration = 1100;
    const start = performance.now();
    el.textContent = `${prefix}${(0).toFixed(decimals)}${suffix}`;

    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = `${prefix}${(target * eased).toFixed(decimals)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = raw;
    }
    requestAnimationFrame(tick);
  }

  const counterObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animateCounter(entry.target as HTMLElement);
          counterObserver.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.6 },
  );
  document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => counterObserver.observe(el));
</script>
