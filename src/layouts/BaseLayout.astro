---
import Nav from '../components/Nav.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  businessName: string;
  tagline?: string;
  colors: { primary: string; secondary: string; accent: string };
  whatsapp?: string;
  phone?: string;
  navLinks?: NavLink[];
  navCtaText?: string;
  navCtaHref?: string;
  fontsHref?: string;
  fontSerif?: string;
  fontSans?: string;
}

const {
  title,
  description = '',
  businessName,
  tagline,
  colors,
  whatsapp,
  phone,
  navLinks = [],
  navCtaText,
  navCtaHref,
  fontsHref,
  fontSerif,
  fontSans,
} = Astro.props;

const themeVars =
  `--color-primary:${colors.primary};` +
  `--color-secondary:${colors.secondary};` +
  `--color-accent:${colors.accent};` +
  (fontSerif ? `--font-serif:${fontSerif};` : '') +
  (fontSans ? `--font-sans:${fontSans};` : '');
---

<!doctype html>
<html lang="it" style={themeVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
    <link rel="icon" href="data:," />
  </head>
  <body class="min-h-screen bg-stone-50 font-sans text-stone-900 antialiased">
    <div
      data-scroll-progress
      class="fixed inset-x-0 top-0 z-50 h-[3px] origin-left bg-primary"
      style="transform: scaleX(0)"
      aria-hidden="true"
    ></div>

    {navLinks.length > 0 && <Nav businessName={businessName} links={navLinks} ctaText={navCtaText} ctaHref={navCtaHref} />}

    <slot />

    <footer data-spotlight class="relative overflow-hidden border-t border-stone-800 bg-stone-950 text-stone-400">
      <div data-spotlight-glow class="pointer-events-none absolute inset-0 z-0 opacity-0 transition-opacity duration-500" aria-hidden="true" />
      <div class="relative z-10 mx-auto max-w-6xl px-6 py-16 sm:px-8">
        <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
          <div class="max-w-sm">
            <p class="font-serif text-2xl text-white">{businessName}</p>
            {tagline && <p class="mt-3 text-sm leading-relaxed">{tagline}</p>}
          </div>

          <div class="flex flex-wrap gap-x-16 gap-y-8">
            {
              navLinks.length > 0 && (
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Sezioni</p>
                  <ul class="mt-4 space-y-2 text-sm">
                    {navLinks.map((link) => (
                      <li>
                        <a href={link.href} class="transition-colors hover:text-white">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
            {
              (phone || whatsapp) && (
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Contatti</p>
                  <ul class="mt-4 space-y-2 text-sm">
                    {phone && (
                      <li>
                        <a href={`tel:${phone.replace(/\s+/g, '')}`} class="transition-colors hover:text-white">
                          {phone}
                        </a>
                      </li>
                    )}
                    {whatsapp && (
                      <li>
                        <a
                          href={`https://wa.me/${whatsapp.replace(/[^0-9]/g, '')}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="transition-colors hover:text-white"
                        >
                          WhatsApp
                        </a>
                      </li>
                    )}
                  </ul>
                </div>
              )
            }
          </div>
        </div>

        <div class="mt-14 flex flex-col-reverse items-center gap-4 border-t border-stone-800 pt-6 text-xs sm:flex-row sm:justify-between">
          <p>&copy; {new Date().getFullYear()} {businessName}</p>
          <span class="inline-flex items-center gap-2 rounded-full border border-stone-700 px-3 py-1 font-medium tracking-wide">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
            Bozza dimostrativa — non ancora online
          </span>
        </div>
      </div>
    </footer>

    {whatsapp && <WhatsAppFloat whatsapp={whatsapp} message={`Ciao! Ho visto la bozza del sito di ${businessName}, vorrei saperne di più.`} />}

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -80px 0px' },
      );
      document.querySelectorAll('[data-reveal], [data-reveal-image]').forEach((el) => observer.observe(el));

      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Tilt 3D leggero al passaggio del mouse, solo su dispositivi con puntatore preciso.
      if (canHover && !reduceMotion) {
        const strength = 7;
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
          card.addEventListener('pointermove', (event) => {
            const rect = card.getBoundingClientRect();
            const px = (event.clientX - rect.left) / rect.width - 0.5;
            const py = (event.clientY - rect.top) / rect.height - 0.5;
            card.style.transform = `perspective(900px) rotateX(${(-py * strength).toFixed(2)}deg) rotateY(${(px * strength).toFixed(2)}deg) scale3d(1.015, 1.015, 1.015)`;
          });
          card.addEventListener('pointerleave', () => {
            card.style.transform = '';
          });
        });
      }

      // Barra di avanzamento lettura, in alto, sempre presente.
      const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (progress) {
        const updateProgress = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progress.style.transform = `scaleX(${ratio})`;
        };
        updateProgress();
        window.addEventListener('scroll', updateProgress, { passive: true });
        window.addEventListener('resize', updateProgress);
      }

      // Pulsanti "magnetici": si spostano verso il cursore anche quando è nelle vicinanze, non solo sopra.
      if (canHover && !reduceMotion) {
        const magneticEls = Array.from(document.querySelectorAll<HTMLElement>('[data-magnetic]'));
        if (magneticEls.length > 0) {
          const radius = 90;
          const strength = 0.4;
          window.addEventListener(
            'pointermove',
            (event) => {
              for (const el of magneticEls) {
                const rect = el.getBoundingClientRect();
                const cx = rect.left + rect.width / 2;
                const cy = rect.top + rect.height / 2;
                const dx = event.clientX - cx;
                const dy = event.clientY - cy;
                const reach = Math.max(rect.width, rect.height) / 2 + radius;
                const dist = Math.hypot(dx, dy);
                if (dist < reach) {
                  const pull = 1 - dist / reach;
                  el.style.transform = `translate(${(dx * strength * pull).toFixed(1)}px, ${(dy * strength * pull).toFixed(1)}px)`;
                } else if (el.style.transform) {
                  el.style.transform = '';
                }
              }
            },
            { passive: true },
          );
        }
      }

      // Bagliore che segue il cursore nelle sezioni scure (footer, fasce "luxury").
      if (canHover) {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((section) => {
          const glow = section.querySelector<HTMLElement>('[data-spotlight-glow]');
          if (!glow) return;
          section.addEventListener('pointermove', (event) => {
            const rect = section.getBoundingClientRect();
            glow.style.background = `radial-gradient(500px circle at ${event.clientX - rect.left}px ${event.clientY - rect.top}px, rgba(255,255,255,0.07), transparent 60%)`;
            glow.style.opacity = '1';
          });
          section.addEventListener('pointerleave', () => {
            glow.style.opacity = '0';
          });
        });
      }
    </script>
  </body>
</html>
